# .env.example -- Copy to .env and fill in real values
# NEVER commit .env to git. Add .env to .gitignore.

# ----- Auth -----
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_256BIT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
API_KEY_HASH_SALT=CHANGE_ME_SALT

# ----- Database -----
POSTGRES_DB=agtech
POSTGRES_USER=agtech
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_PORT=5432
# Use localhost when running tools from host machine.
DATABASE_URL=postgresql://agtech:CHANGE_ME_DB_PASSWORD@localhost:5432/agtech
# Use postgres hostname when running inside Docker network.
DATABASE_URL_DOCKER=postgresql://agtech:CHANGE_ME_DB_PASSWORD@postgres:5432/agtech
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4

# ----- Redis -----
REDIS_PORT=6379

# ----- MinIO -----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----- MQTT -----
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ----- Model -----
DEFAULT_MODEL_VERSION=v1.0.0
ONNX_INFERENCE_TIMEOUT_MS=500
MC_DROPOUT_PASSES=10

# ----- App -----
APP_ENV=development
LOG_LEVEL=INFO
AUTH_REQUIRED=true
WS_REQUIRE_AUTH=true
ENABLE_HSTS=false
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
GATEWAY_MODE=live
AI_SERVING_URL=http://ai-serving:8001
AI_SERVING_TIMEOUT_MS=500
INGESTION_SERVICE_URL=http://ingestion-service:8003
INGESTION_SERVICE_TIMEOUT_MS=500
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY
INTERNAL_API_KEY_HEADER=X-Internal-API-Key
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
ADMIN_RATE_LIMIT_COUNT=60
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_TIMEOUT_MS=1500
ZONE_STATUS_CACHE_TTL_SECONDS=300
AI_SERVING_STRICT_READY=false

# For production, switch RATE_LIMIT_BACKEND=redis and enable HTTPS/HSTS.
# In production, set AUTH_REQUIRED=true, WS_REQUIRE_AUTH=true, and a real INTERNAL_API_KEY.

# ----- Decision Engine -----
DECISION_ENGINE_URL=http://decision-engine:8002
DECISION_ENGINE_TIMEOUT_MS=500

# ----- Readiness / Cache -----
WEATHER_CACHE_TTL_SECONDS=900
IMAGERY_TIMEOUT_MS=1500
IMAGERY_METADATA_CACHE_TTL_SECONDS=21600
REDIS_URL=redis://redis:6379/0

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/updates
DOMAIN=159.223.92.233
TLS_CERT_MODE=self-signed
CERTBOT_EMAIL=
FRONTEND_PORT=8080

# ----- Service Ports -----
API_GATEWAY_PORT=8000
AI_SERVING_PORT=8001
DECISION_ENGINE_PORT=8002
INGESTION_SERVICE_PORT=8003
